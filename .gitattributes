# 统一换行，避免 Windows/Linux 混提交
* text=auto eol=lf

# 源码显式声明
*.py    text eol=lf
*.kt    text eol=lf
*.kts   text eol=lf
*.md    text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
gradlew text eol=lf
*.bat   text eol=crlf

# 二进制：不做换行/文本 diff
*.tflite binary
*.onnx   binary
*.pt     binary
*.pth    binary
*.npy    binary
*.jar    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.zip    binary

# GitHub 语言统计：把 docs 里的脚本从 Python 占比里排掉
docs/** linguist-documentation
